# ===== RAG 服务（服务 B）配置示例 =====
# 复制为 .env 后按实际环境填写。密钥不要提交到 Git。
PORT=8002

# MySQL 数据库（与服务 A 共用同一实例）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=med_workbench

# 上传文件存储根目录（服务 B 唯一持有磁盘写入）
UPLOAD_DIR=./data/uploads
# Qdrant 本地模式数据目录
QDRANT_PATH=./data/qdrant

# 向量化模型：可填 HuggingFace 模型名（首次使用自动下载），
# 或本机已下载模型目录（如 /data/models/bge-base-zh-v1.5）
EMBEDDING_MODEL_NAME=BAAI/bge-base-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8

# 文本分块参数
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_UPLOAD_MB=50

# LLM 语义切分：true 开启（失败自动回退规则切分），false 仅规则切分
LLM_CHUNKING=true
# 单批送入 LLM 的字符上限
LLM_CHUNK_MAX_INPUT=12000

# LLM 语义切分所用的 OpenAI 兼容提供商（kimi / opencode / o98k 任一）
LLM_API_KEY=sk-your-llm-api-key
LLM_BASE_URL=https://api.o98k.de/v1
LLM_MODEL=gpt-5.6-sol
LLM_TIMEOUT=120
