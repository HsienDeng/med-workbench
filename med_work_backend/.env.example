# ==================== AI 提供商 ====================
# 默认 AI 提供商（Redis 未持久化时生效）：kimi / o98k
AI_PROVIDER=kimi

# Kimi (Moonshot AI) 官方 API 配置
# 前往 https://platform.moonshot.cn/ 获取 API Key 后填入
KIMI_API_KEY=sk-你的真实APIKey
# 官方 API 地址（中国大陆版），一般无需修改
KIMI_BASE_URL=https://api.moonshot.cn/v1
# 通用模型：kimi-k3 / kimi-2.6
# 编程模型：kimi-k2.7-code / kimi-k2.7-code-highspeed
# 注意：moonshot-v1 系列与 kimi-k2.5 已于 2026-08-31 下线
KIMI_MODEL=kimi-k3

# O98K 中转站（OpenAI Compatible）配置；支持 gpt / claude / deepseek 等模型的统一网关
O98K_API_KEY=你的O98K中转站APIKey
O98K_BASE_URL=https://api.o98k.de/v1
O98K_MODEL=gpt-5.6-sol

# IMA 外部集成（腾讯 ima.qq.com OpenAPI；AI 助手工具：检索 IMA 知识库 / 保存笔记）
# 前往 https://ima.qq.com 的 agent-interface 页面获取 Client ID 与 API Key
# 留空表示未开通：AI 助手不会注册 IMA 相关工具
# 注意：配置后医疗数据会发往 ima.qq.com（数据出网），请确认合规后再填写
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=

# ==================== 服务端口 ====================
PORT=8001

# ==================== MySQL 数据库 ====================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=med_workbench

# ==================== Redis 与会话 ====================
# 登录令牌存储与缓存
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=你的Redis密码
REDIS_DB=0
# 登录令牌有效期（小时）
SESSION_TTL_HOURS=12

# ==================== RAG 服务代理 ====================
# 知识库文档管理/向量检索全部由独立 med_rag_service 进程承载，本服务仅 HTTP 代理转发。
# UPLOAD_DIR 仅作参考信息传递给服务 B；本进程不操作上传磁盘。
UPLOAD_DIR=./data/uploads
# RAG 服务地址（服务 B，仅内网）
RAG_SERVICE_BASE_URL=http://127.0.0.1:8002
# RAG 请求超时（秒）：上传 + LLM 切分 + 向量化同步执行，需放宽
RAG_SERVICE_TIMEOUT=300

# 说明：QDRANT_PATH / EMBEDDING_MODEL_NAME / CHUNK_SIZE / CHUNK_OVERLAP /
# LLM_CHUNKING / MAX_UPLOAD_MB 等 RAG 本地配置已迁至 med_rag_service/.env

# ==================== 企业微信（客户联系：外部群管理 + 企业群发）====================
# 功能：查询企业微信所有外部群、群绑定患者、向群发起企业群发（需群主在企微客户端确认后发送）
# 前置：企业已认证，自建应用开通「客户联系」权限
# 获取入口：企业微信管理后台 → 客户联系 → 客户 → API 页面
# 留空表示未配置：群管理页面可正常浏览，但同步/推送接口返回 503 引导配置
WX_CORP_ID=ww5dd32c954f848e38
WX_CONTACT_SECRET=客户联系Secret（客户联系-客户-API 页查看）
# 定时同步总开关（true 开启后台自动同步；未配置凭证时即使开启也会自动跳过）
WX_SYNC_ENABLED=false
# 定时同步间隔（小时）
WX_SYNC_INTERVAL_HOURS=6
# 后端启动后是否立即同步一次
WX_SYNC_ON_STARTUP=true
# 单次拉取群列表分页大小（企微限制 1~1000）
WX_SYNC_PAGE_SIZE=100
# 可选：逗号分隔的群主 userid（如 zhangsan,lisi）；留空则拉取应用可见范围内全部群主
# 注意：应用可见范围超 1000 人时企微会拒绝拉取（错误 81017），建议只填实际负责外部群的成员
WX_OWNER_USERIDS=
# 企微接口调用超时（秒）
WX_HTTP_TIMEOUT=30

# --- 第三方推送通道（试点：wecomapi.com，非官方协议，有风控/封号风险）---
# 用途：向「外部群」主动发消息（官方群机器人不支持外部群、未认证企业无法用客户联系 API）。
# 仅建议用测试账号小范围试点，勿在生产环境直接使用真实患者数据。
# WX_WECOMAPI_TOKEN：wecomapi 管理后台获取
# WX_WECOMAPI_GUID：扫码登录成功后填写（入口：群管理页 → 设备登录）
WX_WECOMAPI_TOKEN=
WX_WECOMAPI_BASE_URL=http://manager.wecomapi.com/wecom/finder/api
WX_WECOMAPI_GUID=
WX_WECOMAPI_AREA_CODE=320000
WX_WECOMAPI_DEVICE_NAME=med-workbench
WX_WECOMAPI_PROXY_URL=
